COLUMN TABLE TrainingService_Enrollments_drafts (
  createdAt TIMESTAMP NULL,
  createdBy NVARCHAR(255) NULL,
  modifiedAt TIMESTAMP NULL,
  modifiedBy NVARCHAR(255) NULL,
  Enid NVARCHAR(36) NOT NULL,
  Enrollmentdate DATE NULL,
  Completiondate DATE NULL,
  "SCORE" INTEGER NULL,
  Status NVARCHAR(5000) NULL,
  Reason NVARCHAR(5000) NULL,
  Result NVARCHAR(5000) NULL,
  CertificateNo NVARCHAR(5000) NULL,
  ExpiryDate DATE NULL,
  expiryCriticality INTEGER NULL,
  criticality INTEGER NULL,
  employeeRef_Eid NVARCHAR(36) NULL,
  courseRef_Cid NVARCHAR(36) NULL,
  IsActiveEntity BOOLEAN,
  HasActiveEntity BOOLEAN,
  HasDraftEntity BOOLEAN,
  DraftAdministrativeData_DraftUUID NVARCHAR(36) NOT NULL,
  PRIMARY KEY(Enid)
)